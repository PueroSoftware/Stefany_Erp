{
  "expo": {
    "name": "Tienda Jabones",
    "slug": "tienda-jabones-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/marca/logo.png",
    "userInterfaceStyle": "Light",
    "splash": {
      "image": "./src/assets/hero.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F5"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tiendajabones.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/marca/logo.png",
        "backgroundColor": "#FAF7F5"
      },
      "package": "com.tiendajabones.app"
    },
    "web": {
      "favicon": "./src/assets/marca/logo.png",
      "bundler": "metro"
    },
    "plugins": ["expo-font", "expo-asset"],
    "extra": {
      "eas": {
        "projectId": "tienda-jabones-frontend"
      }
    }
  }
}
